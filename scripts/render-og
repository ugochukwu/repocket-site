#!/usr/bin/env python3
"""Render docs/og/og.html to assets/og.png, the 1200x630 link preview.

Needs Python Playwright with its Chromium (pip install playwright; playwright install chromium).
Usage: scripts/render-og [output.png]   (default: assets/og.png)
"""
import pathlib
import sys

from playwright.sync_api import sync_playwright

root = pathlib.Path(__file__).resolve().parent.parent
source = root / "docs" / "og" / "og.html"
output = pathlib.Path(sys.argv[1]) if len(sys.argv) > 1 else root / "assets" / "og.png"

with sync_playwright() as p:
    browser = p.chromium.launch()
    page = browser.new_page(viewport={"width": 1200, "height": 630}, device_scale_factor=1)
    page.goto(source.as_uri(), wait_until="networkidle")
    page.evaluate("document.fonts.ready")
    if not page.evaluate("document.fonts.check('800 64px \"Bricolage Grotesque\"')"):
        sys.exit("render-og: Bricolage Grotesque 800 did not load")
    page.screenshot(path=str(output), clip={"x": 0, "y": 0, "width": 1200, "height": 630})
    browser.close()
print(f"render-og: wrote {output}")
